<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Garantir a permissão de INTERNET -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MotorApp"
        android:usesCleartextTraffic="true">

        <!-- LoginActivity configurada como TELA INICIAL (LAUNCHER) -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- MainActivity configurada como TELA SECUNDÁRIA -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />
        <activity
            android:name=".CadastroActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".VeiculosActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".CadastrarVeiculoActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".AgendamentoActivity"
            android:exported="false" />

        <!-- ADICIONE ESTA LINHA ABAIXO -->
        <activity
            android:name=".MeusAgendamentosActivity"
            android:exported="false" />

        <activity android:name=".MeusDadosActivity" android:exported="false" />

        <!-- ÁREA DO MECÂNICO (dono da oficina) -->
        <activity
            android:name=".MecanicoActivity"
            android:exported="false" />
        <activity
            android:name=".AgendamentosMecanicoActivity"
            android:exported="false" />

    </application>

</manifest>