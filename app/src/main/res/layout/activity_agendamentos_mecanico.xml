<?xml version="1.0" encoding="utf-8"?>
<!-- LISTA DE AGENDAMENTOS DO MECÂNICO (filtrada pelo card que foi tocado no menu) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <!-- CABEÇALHO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="#FFD54F"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:elevation="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTituloLista"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Agendamentos"
                android:textColor="#111111"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvQtdLista"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Carregando..."
                android:textColor="#333333"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnVoltarLista"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="#333333"
            android:text="Voltar"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            app:cornerRadius="6dp" />
    </LinearLayout>

    <!-- Mensagem quando a lista está vazia -->
    <TextView
        android:id="@+id/tvListaVazia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F8F9FA"
        android:gravity="center"
        android:padding="32dp"
        android:text="Nenhum agendamento aqui. 👍"
        android:textColor="#777777"
        android:textSize="14sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerAgendamentosMecanico"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F8F9FA"
        android:clipToPadding="false"
        android:padding="12dp" />
</LinearLayout>
