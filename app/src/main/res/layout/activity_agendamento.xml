<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="32dp"
            android:text="🛠️ Escolha o Pacote de Revisão"
            android:textColor="#111111"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Spinner para escolher qual carro vai para o agendamento -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Selecione o veículo:"
            android:textColor="#333333"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerVeiculos"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="20dp"
            android:background="@android:drawable/editbox_background_normal" />

        <!-- PACOTE BÁSICO -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🟢 Pacote Básico – Revisão Essencial"
                    android:textColor="#2E7D32"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp"
                    android:text="Ideal para quem quer manter o carro em dia sem gastar muito. Inclui troca de óleo e filtro, verificação de níveis de fluidos (freio, arrefecimento, direção), checagem visual de pastilhas de freio, calibragem de pneus e diagnóstico rápido."
                    android:textColor="#555555"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnBasico"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:backgroundTint="#2E7D32"
                    android:text="Agendar Pacote Básico"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    app:cornerRadius="8dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- PACOTE INTERMEDIÁRIO -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🟡 Pacote Intermediário – Manutenção Completa"
                    android:textColor="#F57F17"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp"
                    android:text="Inclui tudo do básico, além de troca de filtro de ar e de combustível, revisão do sistema de freios (pastilhas e discos), alinhamento e balanceamento, checagem da bateria/elétrica e inspeção da suspensão."
                    android:textColor="#555555"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnIntermediario"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:backgroundTint="#F57F17"
                    android:text="Agendar Pacote Intermediário"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    app:cornerRadius="8dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- PACOTE COMPLETO -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔵 Pacote Completo – Diagnóstico Total"
                    android:textColor="#1565C0"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp"
                    android:text="Inclui tudo dos anteriores, mais diagnóstico eletrônico (scanner automotivo), revisão de arrefecimento e ar-condicionado, velas de ignição, correia dentada, embreagem e transmissão com relatório detalhado."
                    android:textColor="#555555"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnCompleto"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:backgroundTint="#1565C0"
                    android:text="Agendar Pacote Completo"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    app:cornerRadius="8dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>